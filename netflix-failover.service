[Unit]
Description=Check Netflix licensed titles and rotate the existing Xray main/fallback
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/netflix-failover/netflix-failover.py
TimeoutStartSec=12min
TimeoutStopSec=90s
RuntimeDirectory=netflix-failover
RuntimeDirectoryMode=0700
StateDirectory=netflix-failover
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
